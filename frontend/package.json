{
  "name": "home-dashboard",
  "private": true,
  "version": "1.23.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node tools/wr.mjs dev --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "test:layout": "node tools/check-layout.mjs",
    "test:photo-colours": "node tools/check-photo-colours.mjs",
    "db:migrate": "node tools/wr.mjs d1 migrations apply home-hq --remote",
    "db:migrate:local": "wrangler d1 migrations apply home-hq --local",
    "deploy": "vite build && node tools/wr.mjs deploy",
    "secrets": "node tools/secrets.mjs",
    "ha-alerts": "node tools/ha-alerts.mjs",
    "ha-state": "node tools/ha-state.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "vite": "^8.3.1",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "ical.js": "^2.2.1"
  }
}
